# Client Environment Configuration
# ==================================
# With unified backend, all API calls go to the same server (port 8000)

VITE_CLERK_PUBLISHABLE_KEY = # Clerk publishable key for authentication (e.g., "pk_test_123456")

VITE_IMAGE_KIT_ENDPOINT = # Endpoint for ImageKit service (e.g., "https://ik.imagekit.io/your_account")
VITE_IMAGE_KIT_PUBLIC_KEY = # Public key for ImageKit service (e.g., "public_key_123456")

VITE_GEMINI_PUBLIC_KEY = # Public key for Gemini API (e.g., "gemini_public_key_123456")

# Unified Backend URL (replaces both Express and Proxy)
# All endpoints now served from port 8000:
# - /api/chats, /api/userchats, /api/documents (migrated from Express)
# - /api/kotaemon/* (Kotaemon RAG proxy)
# - /api/agent/* (AI Agent system)
VITE_API_URL = http://localhost:8000

# Kotaemon proxy endpoints (same as API_URL for unified backend)
VITE_POST_URL_AGENT = http://localhost:8000/api/kotaemon/chat
VITE_PROXY_URL = http://localhost:8000

# Upload/Delete via N8N webhooks (optional, if using N8N)
VITE_POST_URL_UPLOAD = # N8N webhook for upload (e.g., "http://localhost:5678/webhook/upload")
VITE_POST_URL_DELETE_VECTOR = # N8N webhook for delete (e.g., "http://localhost:5678/webhook/delete")

# Upload directory path (for file path manipulation)
VITE_UPLOAD_DIR = D:/Projects/Programming_Projects/Dicoding-Gen-AI/self-hosted-ai-starter-kit/shared/document/