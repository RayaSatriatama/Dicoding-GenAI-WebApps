# Docker Environment Variables
# Copy this file to .env and fill in your values

# ImageKit Configuration
IMAGE_KIT_ENDPOINT=https://ik.imagekit.io/your_account
IMAGE_KIT_PUBLIC_KEY=your_public_key
IMAGE_KIT_PRIVATE_KEY=your_private_key

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# Kotaemon Configuration (Agent System)
# IP/hostname where Kotaemon is running (e.g., your Windows PC's Tailscale IP)
KOTAEMON_HOST=100.x.x.x
KOTAEMON_URL=http://100.x.x.x:7860
# Path to Kotaemon's sql.db (mounted via volumes in docker-compose)
KOTAEMON_DB_PATH=/app/ktem_app_data/user_data/sql.db

# Server Configuration (for Tailscale/network access)
# Your server's Tailscale IP (so browsers can connect)
SERVER_HOST=100.x.x.x
# Port the backend is exposed on
BACKEND_PORT=3001
