# Kotaemon Proxy Configuration
# =============================
# This is the unified backend that combines:
# - Kotaemon RAG proxy
# - Chat/Document CRUD (migrated from Express.js)
# - AI Agent system (Pydantic AI)

# Kotaemon Server
KOTAEMON_URL=http://localhost:7860
KOTAEMON_USERNAME=admin
KOTAEMON_PASSWORD=admin

# Proxy Server
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Connection (same as Express.js backend)
MONGO=mongodb://localhost:27017/chatapp
DATABASE_NAME=chatapp

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# Development only - skip auth verification
SKIP_AUTH_VERIFICATION=false

# File Upload Directory (shared with Express backend)
UPLOAD_DIR=D:/Projects/Programming_Projects/Dicoding-Gen-AI/self-hosted-ai-starter-kit/shared/document/

# Google AI (for Pydantic AI agent)
GOOGLE_API_KEY=your_google_api_key_here
